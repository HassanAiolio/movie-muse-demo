NODE_ENV=development
# Postgres connection string (Neon, Render, or local). Set DATABASE_SSL=false for a local server.
DATABASE_URL=postgres://postgres@localhost:5432/moviemuse
DATABASE_SSL=false
# Long random string; sessions reset on restart if unset.
JWT_SECRET=change-me
# TMDB v4 read access token (starts with "eyJ") or v3 API key.
TMDB_API_KEY=
# Shared secret for POST /admin/sync (used by .github/workflows/sync.yml).
SYNC_SECRET=
# Optional: comma-separated frontend origins allowed by CORS. Open when empty.
CORS_ORIGIN=
